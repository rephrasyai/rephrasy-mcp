{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rephrasyai/rephrasy-mcp",
  "description": "Humanize AI text and images and check AI-detection scores from Claude, Cursor, or any MCP client.",
  "title": "Rephrasy",
  "websiteUrl": "https://rephrasy.ai",
  "repository": {
    "url": "https://github.com/rephrasyai/rephrasy-mcp",
    "source": "github"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@rephrasy/mcp",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "REPHRASY_API_KEY",
          "description": "Rephrasy API key from your account (rephrasy.ai → Account → API).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://v2-humanizer.rephrasy.ai/mcp"
    }
  ]
}
